#!/bin/sh
# Maven Wrapper: downloads and caches the Apache Maven distribution pinned in
# .mvn/wrapper/maven-wrapper.properties, then delegates to it - no separate Maven
# install required. To change the Maven version, edit that properties file, not this script.
set -e

WRAPPER_DIR=$(cd "$(dirname "$0")" && pwd)
PROPERTIES_FILE="$WRAPPER_DIR/.mvn/wrapper/maven-wrapper.properties"

DISTRIBUTION_URL=$(sed -n 's/^distributionUrl=//p' "$PROPERTIES_FILE")
DIST_ZIP_NAME=$(basename "$DISTRIBUTION_URL")
MAVEN_DIR_NAME=${DIST_ZIP_NAME%-bin.zip}

: "${MAVEN_USER_HOME:=$HOME/.m2/wrapper}"
DIST_DIR="$MAVEN_USER_HOME/dists/$MAVEN_DIR_NAME"
MAVEN_HOME="$DIST_DIR/$MAVEN_DIR_NAME"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$DIST_DIR"
  ZIP_PATH="$DIST_DIR/$DIST_ZIP_NAME"
  echo "mvnw: downloading Maven from $DISTRIBUTION_URL ..." >&2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$ZIP_PATH" "$DISTRIBUTION_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$ZIP_PATH" "$DISTRIBUTION_URL"
  else
    echo "mvnw: need curl or wget on PATH to download Maven" >&2
    exit 1
  fi
  unzip -q "$ZIP_PATH" -d "$DIST_DIR"
  rm -f "$ZIP_PATH"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
